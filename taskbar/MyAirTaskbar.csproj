<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The Claude asterisk of src/main/resources/icons/claude.svg, rendered at 16 to 256 px. -->
    <ApplicationIcon>MyAirTaskbar.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MyAir.Taskbar</RootNamespace>
    <!-- LibraryImport generates its marshalling as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Deskband11Lib.Wpf" Version="[1.4.2]" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Page Remove="tests/**" />
  </ItemGroup>
</Project>
