<Window
    x:Class="MyAir.Taskbar.Flyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Claude sessions"
    Style="{StaticResource Window}">
    <ContentControl Style="{StaticResource Card}">
        <StackPanel>
            <DockPanel Margin="16,14,16,4">
                <TextBlock x:Name="Summary" DockPanel.Dock="Right" VerticalAlignment="Bottom" FontSize="13.5" Foreground="{DynamicResource Secondary}" />
                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="16" FontWeight="SemiBold" Text="Claude sessions" />
            </DockPanel>
            <ItemsControl x:Name="Items" Margin="0,0,0,6" Focusable="False" KeyboardNavigation.DirectionalNavigation="Contained" ButtonBase.Click="OnRowClick" />
            <Border Padding="16,9,16,11" Background="{DynamicResource Footer}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7">
                <TextBlock x:Name="FooterText" FontSize="13.5" Foreground="{DynamicResource Secondary}" />
            </Border>
        </StackPanel>
    </ContentControl>
</Window>
