<Window
    x:Class="MyAir.Taskbar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="My Air taskbar"
    Width="40"
    Height="48"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStyle="None">
    <!-- A nearly transparent background, so clicks between the numbers hit the widget rather than the taskbar. -->
    <!-- Two rows rather than one: a full taskbar leaves little width, and a slot that does not fit is not shown. -->
    <Border
        x:Name="Root"
        Padding="4,0"
        Background="#01000000"
        CornerRadius="4"
        MouseLeftButtonUp="OnClick"
        MouseRightButtonUp="OnClick"
        ToolTipService.InitialShowDelay="200">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Ellipse Width="8" Height="8" Fill="#FFF5A623" />
            <TextBlock x:Name="NeedsInput" Grid.Column="1" Margin="4,0,0,0" FontSize="13" FontWeight="SemiBold" />
            <Ellipse Grid.Row="1" Width="8" Height="8" Fill="#FF4A9EFF" />
            <TextBlock x:Name="Working" Grid.Row="1" Grid.Column="1" Margin="4,0,0,0" FontSize="13" />
        </Grid>
    </Border>
</Window>
