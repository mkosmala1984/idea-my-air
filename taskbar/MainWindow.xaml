<Window
    x:Class="MyAir.Taskbar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="My Air taskbar"
    Width="40"
    Height="48"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStyle="None">
    <!-- A nearly transparent background, so clicks between the numbers hit the widget rather than the taskbar. -->
    <!-- Rows rather than columns: a full taskbar leaves little width, and a slot that does not fit is not shown. -->
    <Border
        x:Name="Root"
        Padding="4,0"
        Background="#01000000"
        CornerRadius="4"
        MouseEnter="OnEnter"
        MouseLeave="OnLeave"
        MouseLeftButtonUp="OnClick"
        MouseRightButtonUp="OnRightClick">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="14" />
                <RowDefinition Height="14" />
            </Grid.RowDefinitions>
            <Ellipse Width="7" Height="7" Fill="{DynamicResource NeedsInputDot}" />
            <TextBlock x:Name="NeedsInput" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" />
            <Ellipse Grid.Row="1" Width="7" Height="7" Fill="{DynamicResource UnreadDot}" />
            <TextBlock x:Name="Unread" Grid.Row="1" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" />
            <Ellipse Grid.Row="2" Width="7" Height="7" Fill="{DynamicResource WorkingDot}" />
            <TextBlock x:Name="Working" Grid.Row="2" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11.5" />
        </Grid>
    </Border>
</Window>
