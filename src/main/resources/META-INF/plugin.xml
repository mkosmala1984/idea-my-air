<idea-plugin>
  <id>dev.myair</id>
  <name>My Air</name>
  <vendor>mkosmala</vendor>
  <description><![CDATA[Lists Claude Code sessions from ~/.claude/projects and resumes them in an editor tab.]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.terminal</depends>
  <!-- The folder tools need the IDE's MCP server; without it the rest of the plugin works as before. -->
  <depends optional="true" config-file="my-air-mcp.xml">com.intellij.mcpServer</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="Claude Sessions" anchor="right" icon="AllIcons.Toolwindows.ToolWindowMessages"
                factoryClass="dev.myair.SessionsToolWindowFactory"/>
    <fileEditorProvider implementation="dev.myair.ClaudeSessionEditorProvider"/>
    <fileIconProvider order="first" implementation="dev.myair.ClaudeSessionFileIconProvider"/>
    <applicationConfigurable parentId="tools" instance="dev.myair.MyAirConfigurable" id="dev.myair.settings" displayName="My Air"/>
    <editorTabTitleProvider implementation="dev.myair.ClaudeSessionTabTitleProvider"/>
    <postStartupActivity implementation="dev.myair.TabsSyncStartup"/>
  </extensions>

  <projectListeners>
    <listener class="dev.myair.TabsSyncListener" topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
  </projectListeners>

  <actions>
    <action id="dev.myair.NewClaudeSession" class="dev.myair.NewClaudeSessionAction" text="New Claude Session"
            description="Start claude in the project directory in an editor tab" icon="AllIcons.General.Add">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="dev.myair.NewClaudeSessionInWorktree" class="dev.myair.NewClaudeSessionInWorktreeAction"
            text="New Claude Session in Worktree..." icon="AllIcons.Vcs.Branch"
            description="Create a worktree on a new branch off a chosen branch and start claude in it in an editor tab">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="dev.myair.FocusClaudeSession" class="dev.myair.FocusClaudeSessionAction" text="Focus Claude Session..."
            description="Switch to the window and tab of a Claude session open in any IDE">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
