<idea-plugin>
  <id>dev.myair</id>
  <name>My Air</name>
  <vendor>mkosmala</vendor>
  <description><![CDATA[Lists Claude Code sessions from ~/.claude/projects (and the projects of other Claude Code profiles) and resumes them in an editor tab.]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.terminal</depends>
  <!-- The change views a session's diff against its base opens in. -->
  <dependencies>
    <module name="intellij.platform.vcs.impl"/>
    <module name="intellij.terminal.frontend"/>
    <!-- The canvas tab's webview (dev.myair.canvasview). -->
    <module name="intellij.platform.ui.jcef"/>
  </dependencies>
  <!-- The folder tools need the IDE's MCP server; without it the rest of the plugin works as before. -->
  <depends optional="true" config-file="my-air-mcp.xml">com.intellij.mcpServer</depends>
  <!-- Branch Diff (idea-branch-diff) follows the active session through its diffTargetProvider extension point. -->
  <depends optional="true" config-file="my-air-branch-diff.xml">dev.kosmala.branch-diff-tree</depends>

  <extensions defaultExtensionNs="com.intellij">
    <projectCloseHandler implementation="dev.myair.editor.ProjectCloseConfirmation"/>
    <toolWindow id="Claude Sessions" anchor="right" icon="AllIcons.Toolwindows.ToolWindowMessages"
                factoryClass="dev.myair.toolwindow.SessionsToolWindowFactory"/>
    <toolWindow id="Session Context" anchor="right" secondary="true" icon="AllIcons.Actions.Preview"
                factoryClass="dev.myair.toolwindow.SessionContextToolWindowFactory"/>
    <fileEditorProvider implementation="dev.myair.editor.ClaudeSessionEditorProvider"/>
    <virtualFileSystem key="myair-session" implementationClass="dev.myair.editor.ClaudeSessionFileSystem"/>
    <fileIconProvider order="first" implementation="dev.myair.editor.ClaudeSessionFileIconProvider"/>
    <virtualFileSystem key="myair-plan" implementationClass="dev.myair.planview.PlanFileSystem"/>
    <fileEditorProvider implementation="dev.myair.planview.PlanEditorProvider"/>
    <fileIconProvider order="first" implementation="dev.myair.planview.PlanFileIconProvider"/>
    <editorTabTitleProvider implementation="dev.myair.planview.PlanTabTitleProvider"/>
    <virtualFileSystem key="myair-review" implementationClass="dev.myair.reviewview.ReviewFileSystem"/>
    <fileEditorProvider implementation="dev.myair.reviewview.ReviewEditorProvider"/>
    <fileIconProvider order="first" implementation="dev.myair.reviewview.ReviewFileIconProvider"/>
    <editorTabTitleProvider implementation="dev.myair.reviewview.ReviewTabTitleProvider"/>
    <virtualFileSystem key="myair-canvas" implementationClass="dev.myair.canvasview.CanvasFileSystem"/>
    <fileEditorProvider implementation="dev.myair.canvasview.CanvasEditorProvider"/>
    <fileIconProvider order="first" implementation="dev.myair.canvasview.CanvasFileIconProvider"/>
    <editorTabTitleProvider implementation="dev.myair.canvasview.CanvasTabTitleProvider"/>
    <virtualFileSystem key="myair-dashboard" implementationClass="dev.myair.dashboard.DashboardFileSystem"/>
    <fileEditorProvider implementation="dev.myair.dashboard.DashboardEditorProvider"/>
    <virtualFileSystem key="myair-scheduled" implementationClass="dev.myair.schedule.ui.ScheduledTasksFileSystem"/>
    <fileEditorProvider implementation="dev.myair.schedule.ui.ScheduledTasksEditorProvider"/>
    <applicationConfigurable parentId="tools" instance="dev.myair.MyAirConfigurable" id="dev.myair.settings" displayName="My Air"/>
    <editorTabTitleProvider implementation="dev.myair.editor.ClaudeSessionTabTitleProvider"/>
    <editorTabColorProvider implementation="dev.myair.editor.ClaudeSessionTabColorProvider"/>
    <postStartupActivity implementation="dev.myair.tabs.TabsSyncStartup"/>
    <postStartupActivity implementation="dev.myair.review.ReviewServiceStartup"/>
    <postStartupActivity implementation="dev.myair.canvas.CanvasServiceStartup"/>
    <editorEmptyStateComponentProvider implementation="dev.myair.prompt.PromptEmptyState"/>
    <notificationGroup id="My Air" displayType="BALLOON"/>
    <notificationGroup id="My Air Scheduled Tasks" displayType="STICKY_BALLOON"/>
  </extensions>

  <applicationListeners>
    <listener class="dev.myair.tabs.SeenOnActivation" topic="com.intellij.openapi.application.ApplicationActivationListener"/>
    <listener class="dev.myair.editor.SessionTerminals$ProjectClose" topic="com.intellij.openapi.project.ProjectCloseListener"/>
  </applicationListeners>

  <projectListeners>
    <listener class="dev.myair.tabs.TabsSyncListener" topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    <listener class="dev.myair.tabs.SingleTabListener" topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
  </projectListeners>

  <actions>
    <action id="dev.myair.NewClaudeSession" class="dev.myair.actions.NewClaudeSessionAction" text="New Claude Session"
            description="Start claude in the project directory in an editor tab" icon="/icons/newSession.svg">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="dev.myair.NewClaudeSessionInWorktree" class="dev.myair.actions.NewClaudeSessionInWorktreeAction"
            text="New Claude Session in Worktree..." icon="AllIcons.Vcs.Branch"
            description="Create a worktree on a new branch off a chosen branch and start claude in it in an editor tab">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="dev.myair.NewSessionWithPrompt" class="dev.myair.prompt.NewSessionWithPromptAction"
            text="New Claude Session with Prompt..." icon="AllIcons.Actions.Edit"
            description="Type the first message and pick a configuration, then start claude in an editor tab">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="dev.myair.OpenSessionsDashboard" class="dev.myair.dashboard.OpenDashboardAction" text="Open Sessions Dashboard"
            description="Show what needs you now, what was left unfinished and what is finished, across all sessions" icon="AllIcons.Actions.ListFiles">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="dev.myair.OpenScheduledTasks" class="dev.myair.schedule.ui.OpenScheduledTasksAction" text="Scheduled Tasks"
            description="Claude sessions started at fixed times: add, edit, run now, and see their runs" icon="AllIcons.Vcs.History">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="dev.myair.FocusClaudeSession" class="dev.myair.actions.FocusClaudeSessionAction" text="Focus Claude Session..."
            description="Switch to the window and tab of a Claude session open in any IDE">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="dev.myair.NextSessionNeedingMe" class="dev.myair.actions.NextSessionNeedingMeAction" text="Next Claude Session Needing Me"
            description="Go to the next Claude session waiting for input or with an unread reply; again for the one after it">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="alt shift K"/>
    </action>
    <action id="dev.myair.InstallMyAirBuild" class="dev.myair.actions.InstallMyAirBuildAction" text="Install My Air Build and Restart"
            description="Install build/distributions/my-air-*.zip of this project over the running My Air and restart the IDE">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="dev.myair.CloseAndSettle" class="dev.myair.editor.CloseAndSettleAction" text="Close and Settle"
            description="Close the session tab, ending its claude, and mark the session settled" icon="AllIcons.Actions.Checked">
      <add-to-group group-id="CloseEditorsGroup" anchor="after" relative-to-action="CloseContent"/>
    </action>
    <group id="dev.myair.MainToolbar">
      <reference ref="dev.myair.NewSessionWithPrompt"/>
      <reference ref="dev.myair.NewClaudeSession"/>
      <reference ref="dev.myair.NewClaudeSessionInWorktree"/>
      <group id="dev.myair.Presets" class="dev.myair.actions.PresetsGroup"/>
      <separator/>
      <add-to-group group-id="MainToolbarRight" anchor="first"/>
    </group>
  </actions>
</idea-plugin>
