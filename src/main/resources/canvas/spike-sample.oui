root = Stack([header, kpis, tabs, form, links])
header = CardHeader("Flaky tests, last 7 days", "Spike frame rendered by My Air")
kpis = Stack([k1, k2, k3], "row", "m", "stretch", "start", true)
k1 = Card([TextContent("Runs", "small"), TextContent("412", "large-heavy")])
k2 = Card([TextContent("Failed", "small"), TextContent("37", "large-heavy")])
k3 = Card([TextContent("Flaky", "small"), TextContent("9", "large-heavy")])
tabs = Tabs([t1, t2, t3])
t1 = TabItem("chart", "By module", [chart])
chart = BarChart(["store", "editor", "review", "planview"], [Series("Failed", [14, 11, 8, 4]), Series("Flaky", [4, 3, 1, 1])], "grouped")
t2 = TabItem("table", "Tests", [table])
table = Table([Col("Test", ["TabStoreTest.a withdrawn", "ClaudeHomeWatcherTest.burst", "ReviewServiceTest.mirror"]), Col("Fails", [6, 4, 2], "number")])
t3 = TabItem("code", "Fix", [md, code])
md = MarkDownRenderer("The watcher test waits **200 ms**; Windows delivers the event after up to `$t_{max} = 350`ms.")
code = CodeBlock("kotlin", "assertTrue(latch.await(2, TimeUnit.SECONDS))")
form = Form("fix", btns, [f1, f2])
f1 = FormControl("Test to fix", Select("test", [SelectItem("watcher", "ClaudeHomeWatcherTest"), SelectItem("store", "TabStoreTest")], "Pick one", { required: true }))
f2 = FormControl("Note", TextArea("note", "Anything the agent should know", 3))
btns = Buttons([Button("Fix it", @ToAssistant("Fix the selected test", {source: "spike"}), "primary"), Button("Skip", @ToAssistant("Skip"), "secondary")])
links = Buttons([Button("OpenUI docs", @OpenUrl("https://www.openui.com/docs"), "tertiary")])
