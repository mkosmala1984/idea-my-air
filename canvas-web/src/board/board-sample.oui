root = Stack([title, board])
title = TextContent("Board spike: a migration pipeline", "large-heavy")
board = Board([source, pipeline, target, stats, risk, todo, e1, e2, e3, e4], 24, 720)
source = Shape("cylinder", "Jira DC", {x: 0, y: 2, w: 6, h: 5})
pipeline = Shape("group", "Migrator", {rightOf: "source", gap: 4, align: "center"}, [export, map, load, m1, m2], "row", 2)
export = Shape("rounded", "Export", {w: 6, h: 3})
map = Shape("rounded", "Map", {w: 6, h: 3})
load = Shape("rounded", "Load", {w: 6, h: 3})
m1 = Edge("export", "map")
m2 = Edge("map", "load")
target = Shape("cylinder", "RTM Cloud", {rightOf: "pipeline", gap: 4, align: "center", w: 6, h: 5})
stats = Frame("Last run", {below: "pipeline", gap: 3, w: 18}, [statsTable, statsButtons])
statsTable = Table([Col("Entity", ["Test cases", "Plans", "Executions"]), Col("Done", [1204, 37, 5310], "number"), Col("Failed", [3, 0, 12], "number")])
statsButtons = Buttons([Button("Rerun failed", @ToAssistant("Rerun the failed entities"), "primary")])
risk = Note("Executions need the step mapping first: TR-11753.", {rightOf: "stats", gap: 2, w: 8}, "pink")
todo = Note("Next: dry run on the staging tenant, then compare counts.", {below: "risk", gap: 1, w: 8}, "yellow")
e1 = Edge("source", "pipeline", "REST export")
e2 = Edge("pipeline", "target", "import API")
e3 = Edge("pipeline", "stats", "report", "straight")
e4 = Edge("risk", "map", "", "curved")
